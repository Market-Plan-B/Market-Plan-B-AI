          474.14080810546875
        ],
        "avg_font_size": 9.219716389973959
      },
      {
        "text": "탑재되는데 메모리 반도체와 Foundry 사업부간의 시너지 효과가 구현된 제품임.",
        "bbox": [
          242.2100067138672,
          479.7483825683594,
          555.69091796875,
          490.365966796875
        ],
        "avg_font_size": 9.220243453979492
      },
      {
        "text": "동사의 Foundry 사업은 3nm 수율의 안정 속에 2nm/1.4nm 제품 개발에 집중하고",
        "bbox": [
          242.2100067138672,
          496.1883850097656,
